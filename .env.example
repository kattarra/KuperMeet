BOT_TOKEN=your_telegram_bot_token

# Comma-separated Telegram user IDs allowed to moderate the bot
ADMIN_IDS=123456789

# Keep the teen segment disabled until age verification and safety controls are implemented.
ENABLE_TEEN_SEGMENT=false
TEEN_AGE_VERIFICATION_ENABLED=false

# Cooper ecosystem channels: add the bot as admin in each configured channel.
# Leave future channel slots empty until those channels join the ecosystem.
CHANNEL_KUPERCOIN=@your_kupercoin_channel
CHANNEL_KUPERSHOP=@your_kuper_shop_channel
CHANNEL_3=
CHANNEL_4=
CHANNEL_5=

# Optional: leave empty to receive moderation and report notifications in admin DMs.
REPORT_CHANNEL=
MOD_CHANNEL=

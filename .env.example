BOT_TOKEN=your_telegram_bot_token

# Comma-separated Telegram user IDs allowed to moderate the bot
ADMIN_IDS=123456789

# Keep the teen segment disabled until age verification and safety controls are implemented.
ENABLE_TEEN_SEGMENT=false
TEEN_AGE_VERIFICATION_ENABLED=false

# Telegram channels (fill in before launch)
CHANNEL_KUPERCOIN=@your_channel
CHANNEL_LUXDECOR=@your_channel
CHANNEL_KUPERSHOP=@your_channel
CHANNEL_4=@your_channel
CHANNEL_5=@your_channel
REPORT_CHANNEL=@your_report_channel
MOD_CHANNEL=@your_moderation_channel
